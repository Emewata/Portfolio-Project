create view deathpercentage as
select
date,
total_cases,
total_deaths,
(total_deaths/total_cases)*100 as deathpercentage
from
coviddeaths
where continent is not null
order by 1,2;

DROP VIEW IF EXISTS deathpercentage;
DROP VIEW IF EXISTS v_country_monthly_death_rate;
CREATE VIEW v_country_monthly_death_rate AS
SELECT
       location,
       DATE_TRUNC('month', date)::date AS month,
       SUM(new_cases)  AS cases,
       SUM(new_deaths) AS deaths,
       SUM(new_deaths) / SUM(new_cases) * 100 AS death_percentage
FROM coviddeaths
WHERE continent IS NOT NULL
GROUP BY location, DATE_TRUNC('month', date);

DROP VIEW IF EXISTS v_country_monthly_death_rate;
CREATE VIEW v_country_monthly_death_rate AS
SELECT
       location,
       DATE_TRUNC('month', date)::date AS month,
       SUM(new_cases)  AS cases,
       SUM(new_deaths) AS deaths,
       SUM(new_deaths) / NULLIF(SUM(new_cases), 0) * 100 AS death_percentage
FROM coviddeaths
WHERE continent IS NOT NULL
GROUP BY location, DATE_TRUNC('month', date);

SELECT * FROM v_country_monthly_death_rate
ORDER BY deaths DESC NULLS LAST
LIMIT 20;

SELECT * FROM v_country_monthly_death_rate
ORDER BY death_percentage DESC NULLS LAST
LIMIT 20;
